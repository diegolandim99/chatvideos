   "source": [
    "# @title ⚙️ Passo 2 — Instalar dependências do sistema\n",
    "import subprocess, sys\n",
    "from IPython.display import display, HTML, clear_output\n",
    "\n",
    "display(HTML('<p style=\"color:#4fc3f7;font-family:monospace;font-size:14px\">⏳ <b>ClipAI</b> — instalando dependências...</p>'))\n",
    "\n",
    "cmds = [\n",
    "    # ffmpeg (codec de vídeo)\n",
    "    ['apt-get', 'install', '-y', '-q', 'ffmpeg'],\n",
    "    # ttyd (terminal interativo no browser)\n",
    "    ['apt-get', 'install', '-y', '-q', 'ttyd'],\n",
    "    # yt-dlp (download de vídeos)\n",
    "    [sys.executable, '-m', 'pip', 'install', '-q', 'yt-dlp'],\n",
    "    # Whisper (transcrição)\n",
    "    [sys.executable, '-m', 'pip', 'install', '-q', 'openai-whisper'],\n",
    "    # srt (geração de legendas)\n",
    "    [sys.executable, '-m', 'pip', 'install', '-q', 'srt'],\n",
    "]\n",
    "\n",
    "nomes = ['ffmpeg', 'ttyd', 'yt-dlp', 'openai-whisper', 'srt']\n",
    "\n",
    "for nome, c in zip(nomes, cmds):\n",
    "    r = subprocess.run(c, capture_output=True, text=True)\n",
    "    status = '✅' if r.returncode == 0 else '❌'\n",
    "    print(f'{status}  {nome}')\n",
    "\n",
    "clear_output(wait=True)\n",
    "print('✅ Dependências instaladas com sucesso!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "cellView": "form",
    "id": "clone_repo"
   },
   "outputs": [],
   "source": [
    "# @title 📦 Passo 3 — Baixar o ClipAI\n",
    "import os, sys, subprocess\n",
    "\n",
    "REPO_URL = \"https://github.com/diegolandim99/chatvideos.git\"  \n",
    "WORK_DIR = \"/tmp/clipai\"\n",
    "\n",
    "if os.path.exists(WORK_DIR):\n",
    "    subprocess.run([\"git\", \"-C\", WORK_DIR, \"pull\", \"--ff-only\", \"--depth\", \"1\"],\n",
    "                   capture_output=True)\n",
    "    print(\"🔄 ClipAI atualizado.\")\n",
    "else:\n",
    "    subprocess.run([\"git\", \"clone\", \"--depth\", \"1\", REPO_URL, WORK_DIR],\n",
    "                   capture_output=True)\n",
    "    print(\"✅ ClipAI baixado.\")\n",
    "\n",
    "os.chdir(WORK_DIR)\n",
    "sys.path.insert(0, WORK_DIR)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "cellView": "form",
    "id": "launch_agent"
   },
   "outputs": [],
   "source": [
    "# @title 🎬 Passo 4 — Iniciar o ClipAI\n",
    "import subprocess, threading, time\n",
    "from IPython.display import display, HTML\n",
    "\n",
    "PORT = 7681\n",
    "\n",
    "def start_terminal():\n",
    "    subprocess.Popen(\n",
    "        [\"ttyd\", \"-p\", str(PORT), \"-W\",\n",
    "         \"bash\", \"-i\", \"-c\",\n",
    "         f\"cd /tmp/clipai && python main.py; exec bash\"],\n",
    "        stdout=subprocess.DEVNULL,\n",
    "        stderr=subprocess.DEVNULL\n",
    "    )\n",
    "\n",
    "t = threading.Thread(target=start_terminal, daemon=True)\n",
    "t.start()\n",
    "time.sleep(2)\n",
    "\n",
    "# Tunnel via colab (porta pública)\n",
    "from google.colab.output import eval_js\n",
    "url = eval_js(f\"google.colab.kernel.proxyPort({PORT})\")\n",
    "\n",
    "display(HTML(f\"\"\"\n",
    "<div style=\"\n",
    "  background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);\n",
    "  border-radius: 12px;\n",
    "  padding: 28px 32px;\n",
    "  text-align: center;\n",
    "  font-family: 'Google Sans', Arial, sans-serif;\n",
    "  margin-top: 12px;\n",
    "\">\n",
    "  <div style=\"font-size: 42px; margin-bottom: 8px;\">🎬</div>\n",
    "  <div style=\"color: #fff; font-size: 22px; font-weight: 700; margin-bottom: 4px;\">\n",
    "    ClipAI está pronto!\n",
    "  </div>\n",
    "  <div style=\"color: #aaa; font-size: 13px; margin-bottom: 20px;\">\n",
    "    YouTube Shorts · TikTok · Instagram Reels\n",
    "  </div>\n",
    "  <a href=\"{url}\" target=\"_blank\" style=\"\n",
    "    display: inline-block;\n",
    "    background: linear-gradient(90deg, #f953c6, #b91d73);\n",
    "    color: white;\n",
    "    text-decoration: none;\n",
    "    padding: 14px 36px;\n",
    "    border-radius: 30px;\n",
    "    font-size: 16px;\n",
    "    font-weight: 700;\n",
    "    letter-spacing: 0.5px;\n",
    "    box-shadow: 0 4px 20px rgba(249,83,198,0.4);\n",
    "  \">🚀 ABRIR O CLIPAI</a>\n",
    "  <div style=\"color: #666; font-size: 11px; margin-top: 16px;\">\n",
    "    Todos os clips são salvos em: <code style=\"color:#f953c6\">Meu Drive/ClipAI/</code>\n",
    "  </div>\n",
    "</div>\n",
    "\"\"\"))"
   ]
